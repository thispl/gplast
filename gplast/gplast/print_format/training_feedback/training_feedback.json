 "font_size": 14,
 "html": "<div>\n    <table width=100%>\n        <tr>\n    <td style=\"text-align:center;font-size:25px;font-family:'Times New Roman', Times, serif\"><u>FEEDBACK ON THE TRAINING PROGRAMME<br></u></td></tr>\n     <!--<tr><td></td></tr>-->\n     <tr>\n    <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Programme Title &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{doc.event_name or ''}}</td></tr>\n     <tr>\n    <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Date of Conduct &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{frappe.utils.format_date(doc.date_of_conduct,'dd-mm-yyyy') or ''}}</td></tr>\n    <tr>\n    <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Venue &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{doc.venue or ''}}</td></tr>\n    </table>\n    <table width=100%>\n    <tr><td style=\"font-size:16px;font-weight:bold;font-family:'Times New Roman', Times, serif\" colspan=4><u>Feedback Result</u></td></tr>\n        {% for i in doc.feedback_result %}\n        \n    <tr> \n       \n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=1%>{{loop.index}}.</td>\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=50%>{{i.conditions}}</td>\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=1%>:</td>\n         {% if i.result == \"Option 1\" %}\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=47%>{{i.option_1}}</td>\n        {% endif %}\n        {% if i.result == \"Option 2\" %}\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=47%>{{i.option_2}}</td>\n        {% endif %}\n        {% if i.result == \"Option 3\" %}\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=47%>{{i.option_3}}</td>\n        {% endif %}\n        {% if i.result == \"Option 4\" %}\n        <td style ='font-size:17px;font-family:Times New Roman\", Times, serif' width=47%>{{i.option_4}}</td>\n        {% endif %}\n    </tr>\n    {% endfor %}\n    <tr>\n    <tr>\n        <td colspan=\"4\" style=\"font-size:16px;font-family:'Times New Roman', Times, serif;text-align:justify;height:70mm\"><u style=\"font-weight:bold;\">General Remarks :</u> {{doc.feedback or ''}}</td>\n    </tr>\n    \n    </table>\n    \n    <br><br><br><table width=100% >\n        <tr>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\" width=65%>Place : {{doc.venue or ''}}</td>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Signature &nbsp;&nbsp;&nbsp;:</td>\n        </tr>\n        <tr>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\" width=65%>Date : {{frappe.utils.format_date(doc.date_of_conduct,'dd-mm-yyyy') or ''}}</td>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Name &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{doc.employee_name or ''}}</td>\n        </tr>\n        <tr>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\" width=65%></td>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Code &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{doc.employee or ''}}</td>\n        </tr>\n        <tr>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\" width=65%></td>\n            <td style=\"font-size:17px;font-family:'Times New Roman', Times, serif\">Department : {{doc.department or ''}}</td>\n        </tr>\n    </table>\n</div>",
