 "html": "\n    \n    <table border=\"1\" width=\"100%\">\n    <tr>\n        \n        <td colspan=\"8\" style=\"text-align:left;\">\n           <b style=\"font-size:28px;\">G-PLAST</b>\n        </td>\n        </tr>\n    <tr style = 'border-top-style:hidden'>\n        \n        <td colspan=\"5\" rowspan='1' style=\"text-align:left;\">\n           <b style=\"font-size:22px;\"><u>MANPOWER REQUISITION FORM (MRF)</u></b>\n        </td>\n       <td colspan=\"2\" rowspan='3' style = 'border-left-style:hidden'>\n            <table border=\"1\" width=\"100%\">\n                <tr>\n                    <td style=\"text-align:center;font-size:20px;border:2px black solid;\"><b>Division/Dept:-</b><br>{{doc.division_department or ''}}</td>\n                </tr>\n                <tr>\n                    <td style=\"text-align:center;font-size:20px;border:2px black solid;border:2px black solid;\"><b>Date: </b>{{frappe.utils.format_date(doc.date,'dd-mm-yyyy') or ''}}</td>\n                </tr>\n                \n            </table>\n        \n        <td colspan=\"1\" style = 'text-align:left;border-left-style:hidden;'><br></td>\n        </tr>\n        <tr style = 'border-top-style:hidden'>\n         <td colspan=\"8\" style = 'margin-left:70px;font-size:20px;'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(To be retured to the HRD Department)</td>\n    </tr>\n    <tr style = 'border-top-style:hidden'> \n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Prepared by (HOD)&nbsp;&nbsp;<b>{{doc.prepared_by_employee_name or ''}}</b></td>\n    </tr>\n    <tr style = 'border-top-style:hidden'> \n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Unit / Section&nbsp;&nbsp;<b>{{doc.unit or ''}} / {{doc.section or ''}}</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Needed When&nbsp;<b>{{frappe.utils.format_date(doc.need_when,'dd-mm-yyyy') or ''}} </b></td>\n   \n    </tr>\n    \n    <tr style = 'border-top-style:hidden'> \n    {% if doc.sex=='Male' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Sex - Male \u2611&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Female \u2610&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Others \u2610<b></b></td>\n    {% endif %}\n    {% if doc.sex=='Female' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Sex - Male \u2610&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Female \u2611&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Others \u2610<b></b></td>\n    {% endif %}\n    {% if doc.sex=='Others' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Sex - Male \u2610&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Female \u2610&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Others \u2611<b></b></td>\n    {% endif %}\n     {% if doc.sex=='Transgender' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Sex - Male \u2610&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&