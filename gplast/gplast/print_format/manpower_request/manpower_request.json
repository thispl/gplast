='text-align:left;font-size:20px;'>Technical<b Style='font-size:25px;'>\u2610</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Non-Technical<b  Style='font-size:25px;'>\u2610</b><b></b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Commercial/Gen<b  Style='font-size:25px;'>\u2611</b><b></b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Temporary /Casual<b  Style='font-size:25px;'>\u2610</b><b></b></td>\n    {% endif %}\n     {% if doc.type=='Temporary/Casual' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Technical<b Style='font-size:25px;'>\u2610</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Non-Technical<b  Style='font-size:25px;'>\u2610</b><b></b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Commercial/Gen<b  Style='font-size:25px;'>\u2610</b><b></b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Temporary /Casual<b  Style='font-size:25px;'>\u2610</b><b></b></td>\n    {% endif %}\n     <tr style = 'border-top-style:hidden'> \n        <td colspan = '5' style ='text-align:left;font-size:20px;'>In Case Of Operators Please Specify Machine Name</td>\n              <td colspan=\"3\" style = 'border-left-style:hidden'>\n\n        <table border=\"1\" width=\"100%\">\n                <tr >\n                    <td style=\"text-align:center;font-size:15px;border:2px black solid;border:2px black solid;\">{{doc.in_case_of_operators_please_specify_machine_name or ''}}</td>\n                </tr>\n                \n            </table>\n    </tr>\n    <tr style = 'border-top-style:hidden'> \n    {% if doc.vacancy_due_to=='Resignation' %}\n        <td colspan = '8' style ='text-align:left;font-size:20px;'>Vacancy Due to :&nbsp;&nbsp;&nbsp;&nbsp;Resignation<b Style='font-size:20px;'> \u2611</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Expansion<b  Style='font-size:20px;'> \u2610</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Workload<b  sty